# Copia este archivo a .env y rellena los valores.
# .env NUNCA se commitea (está en .gitignore).

# ─── Django ───
# Genera con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CAMBIAME_POR_UNA_CLAVE_GENERADA_DE_50_CHARS
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,[::1]

# ─── Producción (Fase 4) ───
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# --- S3 / SeaweedFS (Fase 3) ---
# Dev local con SeaweedFS: USE_S3=True + credenciales 'any'
# Prod con Backblaze B2: USE_S3=True + credenciales reales + endpoint real
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# Solo SeaweedFS local:
# AWS_S3_ENDPOINT_URL=http://127.0.0.1:8333
AWS_S3_REGION_NAME=us-east-1
