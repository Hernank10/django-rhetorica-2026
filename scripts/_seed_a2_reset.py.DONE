def header(n, t):
    print(); print("=" * 78); print(f"[{n}] {t}"); print("=" * 78)


header("A", "PLAN DE RESET A2")

ejs_viejos = list(EJ.objects.filter(tecnica__nivel_mcer="A2"))
print(f"  Ejercicios A2 actuales: {len(ejs_viejos)}")
print(f"  Se borraran TODOS y se crearan {len(E)} nuevos")

# Validar tecnicas
tec_nums = set(e[0] for e in E)
tec_existentes = set(TL.objects.filter(nivel_mcer="A2", numero__in=tec_nums).values_list("numero", flat=True))
faltantes = tec_nums - tec_existentes
if faltantes:
    print(f"  [ERROR] Tecnicas inexistentes: {sorted(faltantes)}")
    sys.exit(1)
print(f"  [OK] Las {len(tec_nums)} tecnicas referenciadas existen")

# Validar textos
txt_ids = set(e[1] for e in E)
txt_existentes = set(TX.objects.filter(nivel_mcer="A2", id__in=txt_ids).values_list("id", flat=True))
faltantes_tx = txt_ids - txt_existentes
if faltantes_tx:
    print(f"  [ERROR] Textos inexistentes: {sorted(faltantes_tx)}")
    sys.exit(1)
print(f"  [OK] Los {len(txt_ids)} textos referenciados existen")

# Validar pares (tec, texto) unicos
pares = [(e[0], e[1]) for e in E]
pares_dup = [p for p, c in Counter(pares).items() if c > 1]
if pares_dup:
    print(f"  [WARN] {len(pares_dup)} pares (tec, texto) duplicados (se permiten, pero revisar):")
    for p in pares_dup[:5]:
        print(f"    tec #{p[0]} / texto {p[1]}: {Counter(pares)[p]} veces")

# Distribucion esperada
tec_por_texto = defaultdict(int)
for row in E:
    tec_por_texto[row[1]] += 1

header("B", "DISTRIBUCION ESPERADA")
for tid in sorted(tec_por_texto.keys()):
    tx = TX.objects.filter(id=tid).first()
    titulo = tx.titulo[:40] if tx else "?"
    print(f"  texto {tid:>3}: {tec_por_texto[tid]:>3} ejercicios  -> {titulo}")

# Validar cada tecnica tiene exactamente 2 ejercicios
tec_count = Counter(e[0] for e in E)
tec_no_2 = {num: c for num, c in tec_count.items() if c != 2}
if tec_no_2:
    print(f"\n  [WARN] Tecnicas con != 2 ejercicios:")
    for num, c in sorted(tec_no_2.items()):
        print(f"    tec #{num}: {c} ejercicios")
else:
    print(f"\n  [OK] Las 100 tecnicas tienen exactamente 2 ejercicios cada una")

header("C", "APLICAR" if args.apply else "DRY-RUN")

if not args.apply:
    print("  DRY-RUN. Nada modificado.")
    print(f"  Se borrarian {len(ejs_viejos)} ejercicios viejos.")
    print(f"  Se crearian {len(E)} ejercicios nuevos.")
    print("  Ejecuta con --apply para aplicar.")
    sys.exit(0)

with transaction.atomic():
    # Borrar viejos
    borrados = 0
    for ej in ejs_viejos:
        ej.delete()
        borrados += 1
    print(f"\n  [OK] {borrados} ejercicios borrados")

    # Cachear tecnicas
    tec_por_num = {t.numero: t for t in TL.objects.filter(nivel_mcer="A2")}

    # Crear nuevos
    creados = 0
    errores = 0
    for tec_num, texto_id, enun, ops, corr, expl in E:
        tec = tec_por_num.get(tec_num)
        if not tec:
            errores += 1
            continue
        EJ.objects.create(
            tecnica=tec,
            texto_id=texto_id,
            enunciado=enun,
            tipo="multiple_choice",
            payload={
                "opciones": [f"{chr(65+i)}) {op}" for i, op in enumerate(ops)],
                "correcta": corr,
                "explicacion": expl,
            },
            orden=0,
        )
        creados += 1

    print(f"  [OK] {creados} ejercicios creados")
    if errores:
        print(f"  [WARN] {errores} errores")

header("D", "VERIFICAR")

ejs_finales = list(EJ.objects.filter(tecnica__nivel_mcer="A2")
                   .select_related("tecnica", "texto"))
print(f"  Total ejercicios A2: {len(ejs_finales)}")

por_tec = Counter(e.tecnica_id for e in ejs_finales)
tec_con_2 = sum(1 for v in por_tec.values() if v >= 2)
tec_con_1 = sum(1 for v in por_tec.values() if v == 1)
tec_con_0 = sum(1 for v in por_tec.values() if v == 0)
print(f"  Tecnicas con 0 ej: {tec_con_0}")
print(f"  Tecnicas con 1 ej: {tec_con_1}")
print(f"  Tecnicas con 2+ ej: {tec_con_2}")
ratio = len(ejs_finales) / max(1, len(por_tec))
print(f"  Ratio: {ratio:.2f}  (objetivo 2.00)")

# Coherencia aproximada
STOPWORDS = {
    "para", "como", "porque", "cuando", "donde", "sobre", "entre", "desde",
    "hasta", "segun", "texto", "oracion", "frase", "palabra", "palabras",
    "siguiente", "siguientes", "correcta", "incorrecta", "verdadera", "falsa",
    "dice", "menciona", "aparece", "indica", "significa", "cual", "como",
    "que", "quien", "donde", "cuando", "por", "con", "los", "las", "una",
    "uno", "del", "que", "este", "esta", "estos", "estas", "mas", "pero",
    "hace", "hizo", "sido", "tiene", "tenia",
}

def tokens(text):
    if not text:
        return set()
    text = str(text).lower()
    words = re.findall(r"\b[a-z\u00e1\u00e9\u00ed\u00f3\u00fa\u00f1\u00fc]+\b", text)
    return {w for w in words if len(w) > 4 and w not in STOPWORDS}

META_PATTERNS = [
    r"en el texto", r"del texto", r"segun el texto",
    r"el texto (es|tiene|dice|trata|presenta|sigue|esta)",
    r"cual es (el|la) (tema|titulo|idea|conclusion|estructura|proposito|tono|narrador|escenario)",
    r"de que trata", r"que tipo de (texto|estructura|lenguaje)",
    r"cual de estas (frases|palabras|afirmaciones)",
    r"como (esta|se) (organizada|estructura|narra|comunica)",
]

def es_meta_pregunta(enunciado):
    e = (enunciado or "").lower()
    return any(re.search(p, e) for p in META_PATTERNS)

def es_coherente(e):
    if not e.texto or not e.payload:
        return False
    # Whitelist: meta-preguntas son coherentes por definicion
    if es_meta_pregunta(e.enunciado):
        return True
    tx_tokens = tokens(e.texto.cuerpo if e.texto else "")
    enun_tokens = tokens(e.enunciado or "")
    expl_tokens = tokens(e.payload.get("explicacion", "") if isinstance(e.payload, dict) else "")
    combined = enun_tokens | expl_tokens
    return len(tx_tokens & combined) >= 1

coherentes = sum(1 for e in ejs_finales if es_coherente(e))
incoherentes = len(ejs_finales) - coherentes
pct = 100 * coherentes / max(1, len(ejs_finales))

print(f"\n  Coherentes:   {coherentes}/{len(ejs_finales)} ({pct:.1f}%)")
print(f"  Incoherentes: {incoherentes}/{len(ejs_finales)}")

if incoherentes > 20:
    print(f"\n  [WARN] Muchos incoherentes. Revisar contenido:")
    mostrados = 0
    for e in ejs_finales:
        if not es_coherente(e) and mostrados < 10:
            tx_t = e.texto.titulo[:30] if e.texto else "?"
            print(f"    tec #{e.tecnica.numero}: '{e.enunciado[:60]}' -> texto='{tx_t}'")
            mostrados += 1

# Veredicto
header("VEREDICTO", "FASE 3b A2")

ok_tec = (tec_con_2 == 100 and tec_con_1 == 0)
ok_count = (len(ejs_finales) == 200)
ok_ratio = (ratio >= 1.95)
ok_coh = (pct >= 90)

checks = [
    ("200 ejercicios", ok_count),
    ("100 tecnicas x 2", ok_tec),
    ("ratio ~2.00", ok_ratio),
    ("coherencia >= 90%", ok_coh),
]
for name, ok in checks:
    print(f"  [{'OK' if ok else 'FAIL'}] {name}")

if all(ok for _, ok in checks):
    print(f"\n  [OK] FASE 3b A2 COMPLETA")
else:
    print(f"\n  [WARN] Revisar fallos antes de F5")

print()