{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://django-rhetorica/schemas/microejercicio.schema.json",
  "title": "MicroEjercicio Adaptativo",
  "description": "Contrato de contenido JSON para EjercicioLinguistico con es_adaptativo=True",
  "type": "object",
  "required": [
    "tipo_adaptativo",
    "foco",
    "enunciado",
    "opciones",
    "respuesta_correcta",
    "retroalimentacion_adaptativa"
  ],
  "additionalProperties": false,
  "properties": {
    "tipo_adaptativo": {
      "type": "string",
      "const": "micro_ejercicio"
    },
    "foco": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "description": "Slug de categoria_gramatical. Debe coincidir con CATEGORIAS en services/adaptive.py"
    },
    "enunciado": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "opciones": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "respuesta_correcta": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "retroalimentacion_adaptativa": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "description": "Explicacion pedagogica del error cometido"
    },
    "pista": {
      "type": "string",
      "maxLength": 500,
      "description": "Opcional. Aparece si el estudiante falla 2 veces seguidas"
    }
  }
}